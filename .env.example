# ─── Required ────────────────────────────────────────────────────────────────

# PostgreSQL connection string (provided automatically by Replit)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Express session signing secret (generate with: openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-random-64-char-string

# ─── AI Features ─────────────────────────────────────────────────────────────
# Groq API key is NOT stored here — it is supplied per-request by the client
# via the x-groq-api-key header. Users obtain their key at:
#   https://console.groq.com/keys
# The key is stored in the user's browser (localStorage) and never persisted
# on the server.

# ─── Optional Search Keys ────────────────────────────────────────────────────

# PubMed rate limit: 10 req/s with key, 3 req/s without (optional)
# NCBI_API_KEY=your_ncbi_key_here

# CORE academic search (optional)
# CORE_API_KEY=your_core_key_here

# ─── CORS (Production) ───────────────────────────────────────────────────────
# Comma-separated list of allowed origins in production.
# Falls back to REPLIT_DOMAINS automatically when deployed on Replit.
# Example: ALLOWED_ORIGINS=https://myapp.vercel.app,https://myapp.com
# ALLOWED_ORIGINS=
